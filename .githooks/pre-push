#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
checker="$repo_root/scripts/check_repo_hygiene.sh"
remote_name=${1:-origin}
zero=0000000000000000000000000000000000000000
declare -A checked=()

check_commit() {
    local commit=$1
    [[ -n ${checked[$commit]:-} ]] && return
    "$checker" --ref "$commit"
    checked[$commit]=1
}

while read -r local_ref local_sha remote_ref remote_sha; do
    [[ -n ${local_sha:-} && "$local_sha" != "$zero" ]] || continue
    check_commit "$local_sha"

    if [[ "${remote_sha:-$zero}" != "$zero" ]] && \
       git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
        range="$remote_sha..$local_sha"
        while read -r commit; do
            [[ -n "$commit" ]] && check_commit "$commit"
        done < <(git rev-list --reverse "$range")
    else
        while read -r commit; do
            [[ -n "$commit" ]] && check_commit "$commit"
        done < <(git rev-list --reverse "$local_sha" --not --remotes="$remote_name")
    fi
done
